-- TODO: Comments with list indexing inside ir are broken
-- TODO: Fix line breaks on global removal
GLOBAL 
  BITS : 2;
  UNUSED : 0;

MODULE main
VAR
  bits := [counter_cell(TRUE)];
  for i := 1..BITS do
    bits.append(counter_cell(bits[i-1]));
  od;
SPEC
  AG AF bits[2].carry_out

MODULE counter_cell(carry_in)
VAR
  value : boolean;
ASSIGN
  init(value) := FALSE;
  next(value) := value xor carry_in;
DEFINE
  carry_out := value & carry_in;
