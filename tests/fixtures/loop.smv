-- TODO: Comments with list indexing inside ir are broken
MODULE main
VAR
  bit0 : counter_cell(TRUE);
  bit1 : counter_cell(bit0);
  bit2 : counter_cell(bit1);

SPEC
  AG AF bit2.carry_out

MODULE counter_cell(carry_in)
VAR
  value : boolean;
ASSIGN
  init(value) := FALSE;
  next(value) := value xor carry_in;
DEFINE
  carry_out := value & carry_in;
