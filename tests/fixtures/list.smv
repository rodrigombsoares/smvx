-- Using smvx list syntax in the example
MODULE main
VAR
  server0 : server_node(TRUE);
server1 : server_node(FALSE);
server2 : server_node(FALSE);

  server3 : server_node(FALSE);

  server4 : server_node(server0.active);

  
  master_server : server_node(server0.active);

SPEC
  -- This also implies your parser could eventually map standard array indexing
  -- to the underlying generated variables.
  AG (server0.active | server1.active | server2.active | server3.active)

MODULE server_node(is_master)
VAR
  active : boolean;
ASSIGN
  init(active) := is_master;
  next(active) := active; -- simplified logic
