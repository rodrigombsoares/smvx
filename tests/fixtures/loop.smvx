-- TODO: should extend rule to parse bits i-1 for example
-- Also, comments with list indexin inside ir are broken
MODULE main
VAR
  bits := [counter_cell(TRUE)];
  for i := 1..3 do
    bits.append(counter_cell(bits[1]));
  od;
SPEC
  AG AF bits[2].carry_out

MODULE counter_cell(carry_in)
VAR
  value : boolean;
ASSIGN
  init(value) := FALSE;
  next(value) := value xor carry_in;
DEFINE
  carry_out := value & carry_in;
