-- Using smvx list syntax in the example
MODULE main
VAR
  servers := [server_node(TRUE), server_node(FALSE), server_node(FALSE)];
  servers.append(server_node(FALSE));
  servers.append(server_node(servers[0].active));
  
  master_server : server_node(servers[0].active);

DEFINE
  some_server := master_server.active != servers[0].active;
  test_forward := 1 != 0;

SPEC
  -- This also implies your parser could eventually map standard array indexing
  -- to the underlying generated variables.
  AG (servers[0].active | servers[1].active | servers[2].active | servers[3].active)

MODULE server_node(is_master)
VAR
  active : boolean;
ASSIGN
  init(active) := is_master;
  next(active) := active; -- simplified logic
