MODULE main
  VAR
    servers := [server_node(TRUE), server_node(FALSE), server_node(FALSE)];
    servers.append(server_node(FALSE));
    servers.append(server_node(servers[0].active));
    master_server : server_node(servers[0].active);
    monitor : monitor_node(...servers)

  DEFINE
    some_server := master_server.active != servers[0].active;
    test_forward := 1 != 0;

MODULE server_node(is_master)
  VAR
    active : boolean;
  ASSIGN
    init(active) := is_master;
    next(active) := active;

MODULE monitor_node(...servers)
  SPEC
    AG (servers[0].active | servers[1].active | servers[2].active | servers[3].active | servers[4].active)
