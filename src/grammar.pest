// We cannot use the default WHITESPACE and COMMENT rules, we need to handle comments and explicit spacing
// otherwise nusvm chunks will not be parsed containing trailing \n
ws = _{ " " | "\t" }
newline = _{ "\r\n" | "\n" }
comment = _{ "--" ~ (!newline ~ ANY)* }
sp = _{ (ws | comment)* }
sp_nl = _{ (ws | newline | comment)* }
indent = @{ ws* }

// Identifiers
identifier_char = _{ ASCII_ALPHANUMERIC | "_" }
var_name       = @{ identifier_char+ }
number = { ASCII_DIGIT+ }

// import
path   = { (ASCII_ALPHANUMERIC | "/" | "." | "_" | "-")+ }
import_stmt = { indent ~ "import" ~ sp ~ "\"" ~ path ~ "\"" ~ sp ~ ";" }

// Globals
global_val  = { number }
global_decl = { sp_nl ~ var_name ~ sp ~ ":" ~ sp ~ global_val ~ sp ~ ";" }
global_block = { "GLOBAL" ~ sp_nl ~ global_decl* }

// List definition
list = { indent ~ var_name ~ sp ~ ":=" ~ sp ~ list_val ~ sp ~ ";" ~ (ws* ~ newline)? }
list_chunk = @{ (!(list_idx_lookahead | "[" | "]" | "," | ";" | "(" | ")") ~ ANY)+ }
list_indexed_value = { list_indexing ~ list_chunk? }
list_element = { (list_indexed_value | paren_expr | list_chunk)+ }

list_val = {
    "[" ~ sp ~ "]" |
    "[" ~ sp ~ list_element ~ (sp ~ "," ~ sp ~ list_element)* ~ sp ~ "]"
}

// List indexing (allows expressions like 'i-1' or '0')
math_op = { "+" | "-" }
index_operand = @{ identifier_char+ | ASCII_DIGIT+ }
index_math = { index_operand ~ sp ~ math_op ~ sp ~ index_operand }
list_idx = { index_math | index_operand }
list_indexing = { var_name ~ sp ~ "[" ~ sp ~ list_idx ~ sp ~ "]" }

// List unpacking
list_unpack = {"..." ~ var_name}

// Dynamic Constructor (Matches only if '[' is present inside parens)
constructor_name = @{ identifier_char+ }
dyn_constructor  = { 
    constructor_name ~ sp ~ 
    &("(" ~ dyn_lookahead) ~ 
    "(" ~ sp ~ arg_expr* ~ sp ~ ")" 
}

// List append and Argument structures
arg_chunk = @{ (!("(" | ")" | ";" | list_idx_lookahead) ~ ANY)+ }
paren_expr = { "(" ~ sp ~ arg_expr* ~ sp ~ ")" }
value_interpol = { "{{" ~ sp ~ list_idx ~ sp ~ "}}" }
arg_expr = _{ list_indexing | value_interpol | paren_expr | reduce_expr | arg_chunk }

append_element = { dyn_constructor | arg_expr+ }
list_append = { indent ~ var_name ~ sp ~ "." ~ sp ~ "append" ~ sp ~ "(" ~ sp ~ append_element ~ sp ~ ")" ~ sp ~ ";" ~ (ws* ~ newline)* }

// For loops (do ... od;)
loop_var = @{ identifier_char+ }
range_start = { number | var_name}
range_end = { number | var_name}

for_body = _{ for_loop | reduce_expr | expand_expr | list | list_indexing | list_unpack | list_append | dyn_constructor | import_stmt | id_interpol | raw_nusmv_chunk }
// No sp_nl separator between "do" and the body, or between body items: raw_nusmv_chunk
// must capture inter-item whitespace/newlines itself, otherwise indentation and spacing is lost.
for_loop = { 
    indent ~ "for" ~ ws+ ~ loop_var ~ sp ~ ":=" ~ sp ~ range_start ~ sp ~ ".." ~ sp ~ range_end ~ sp ~ "do" ~ 
    for_body* ~ 
    sp ~ "od" ~ sp ~ ";"
}

// List reduce - Macro
reduce_op = { "|" | "&" | "xor" | "+" | "*" }
reduce_expr = { 
    sp_nl ~ "reduce!" ~ "(" ~ sp ~ 
    reduce_op ~ sp ~ "," ~ sp ~ 
    loop_var ~ sp ~ ":=" ~ sp ~ range_start ~ sp ~ ".." ~ sp ~ range_end ~ sp ~ "," ~ sp ~ 
    arg_expr* ~ sp ~ 
    ")" 
}

// Identifier interpolation
id_interpol = { var_name ~ "{" ~ sp ~ (index_math | index_operand) ~ sp ~ "}"} 

// Expand - Macro
expand_expr = {
    "expand!" ~ sp ~ "(" ~ sp ~
    (id_interpol | arg_expr) ~ sp ~ "," ~ sp ~
    loop_var ~ sp ~ ":=" ~ sp ~ range_start ~ sp ~ ".." ~ sp ~ range_end ~ sp ~ 
    ")"
}

// --- LOOKAHEADS ---
import_lookahead       = _{ indent ~ "import" ~ sp ~ "\"" }
list_lookahead         = _{ indent ~ var_name ~ sp ~ ":=" ~ sp ~ "[" }
list_idx_lookahead     = _{ var_name ~ sp ~ "[" }
list_append_lookahead  = _{ indent ~ var_name ~ sp ~ "." ~ sp ~ "append" }
for_lookahead          = _{ indent ~ "for" ~ ws+ ~ identifier_char+ ~ sp ~ ":=" }
od_lookahead           = _{ indent ~ "od" ~ sp ~ ";" }
global_lookahead       = _{ "GLOBAL" ~ sp }
dyn_lookahead          = _{ (!")" ~ ANY)* ~ "[" } // Lookahead to ensure parens contain a '[' before matching as dynamic
reduce_lookahead       = _{ "reduce!" ~ "(" }
expand_lookahead       = _{ "expand!" ~ sp ~ "(" }

// Raw NuSMV Chunk Catch-All
raw_char = _{ comment | !(value_interpol | list_unpack | import_lookahead | list_lookahead | list_idx_lookahead | list_append_lookahead | for_lookahead | od_lookahead | dyn_constructor | global_lookahead | reduce_lookahead | expand_lookahead | id_interpol) ~ ANY }
raw_nusmv_chunk = { raw_char+ }

// SMVX Program
// TODO: unify this with for_body (deduplicate)
program = { SOI ~ (global_block | value_interpol | for_loop | reduce_expr | expand_expr | list | list_indexing | list_unpack | list_append | dyn_constructor | import_stmt | id_interpol | raw_nusmv_chunk)* ~ EOI }
