// We cannot use the default WHITESPACE and COMMENT rules, we need to handle comments and explicit spacing
// otherwise nusvm chunks will not be parsed containing trailing \n
ws = _{ " " | "\t" }
newline = _{ "\r\n" | "\n" }
comment = _{ "--" ~ (!newline ~ ANY)* }
sp = _{ (ws | comment)* }
sp_nl = _{ (ws | newline | comment)* }
indent = @{ ws* }

// Identifiers
identifier_char = _{ ASCII_ALPHANUMERIC | "_" }
var_name       = @{ identifier_char+ }
number = { ASCII_DIGIT+ }

// import
path   = { (ASCII_ALPHANUMERIC | "/" | "." | "_" | "-")+ }
import_stmt = { indent ~ "import" ~ sp ~ "\"" ~ path ~ "\"" ~ sp ~ ";" }

// Globals
global_val  = { number }
global_decl = { sp_nl ~ var_name ~ sp ~ ":" ~ sp ~ global_val ~ sp ~ ";" }
global_block = { "GLOBAL" ~ sp_nl ~ global_decl* }

// List definition
list = { indent ~ var_name ~ sp ~ ":=" ~ sp ~ list_val ~ sp ~ ";" ~ (ws* ~ newline)? }
list_element = { (!("[" | "]" | "," | ";") ~ ANY)+ }

list_val = {
    "[" ~ sp ~ "]" |
    "[" ~ sp ~ list_element ~ (sp ~ "," ~ sp ~ list_element)* ~ sp ~ "]"
}

// List indexing (allows expressions like 'i-1' or '0')
math_op = { "+" | "-" }
index_operand = @{ identifier_char+ | ASCII_DIGIT+ }
index_math = { index_operand ~ sp ~ math_op ~ sp ~ index_operand }
list_idx = { index_math | index_operand }
list_indexing = { var_name ~ sp ~ "[" ~ sp ~ list_idx ~ sp ~ "]" }

// List unpacking
list_unpack = {"..." ~ var_name}

// Dynamic Constructor (Matches only if '[' is present inside parens)
constructor_name = @{ identifier_char+ }
dyn_constructor  = { 
    constructor_name ~ sp ~ 
    &("(" ~ dyn_lookahead) ~ 
    "(" ~ sp ~ arg_expr* ~ sp ~ ")" 
}

// List append and Argument structures
arg_chunk = @{ (!("(" | ")" | ";" | list_idx_lookahead) ~ ANY)+ }
paren_expr = { "(" ~ sp ~ arg_expr* ~ sp ~ ")" }
arg_expr = _{ list_indexing | paren_expr | arg_chunk }

append_element = { dyn_constructor | arg_expr+ }
list_append = { indent ~ var_name ~ sp ~ "." ~ sp ~ "append" ~ sp ~ "(" ~ sp ~ append_element ~ sp ~ ")" ~ sp ~ ";" ~ (ws* ~ newline)* }

// For loops (do ... od;)
loop_var = @{ identifier_char+ }
range_start = { number | var_name}
range_end = { number | var_name}

for_body = _{ for_loop | list | list_indexing | list_append | dyn_constructor | raw_nusmv_chunk }
for_loop = { 
    indent ~ "for" ~ ws+ ~ loop_var ~ sp ~ ":=" ~ sp ~ range_start ~ sp ~ ".." ~ sp ~ range_end ~ sp ~ "do" ~ sp_nl ~ 
    (for_body ~ sp_nl)* ~ 
    "od" ~ sp ~ ";" 
}

// Macros
reduce_op = { "|" | "&" | "xor" | "+" | "*" }
reduce_expr = { 
    "reduce!" ~ "(" ~ sp ~ 
    reduce_op ~ sp ~ "," ~ sp ~ 
    loop_var ~ sp ~ ":=" ~ sp ~ range_start ~ sp ~ ".." ~ sp ~ range_end ~ sp ~ "," ~ sp ~ 
    arg_expr* ~ sp ~ 
    ")" 
}

// --- LOOKAHEADS ---
import_lookahead       = _{ indent ~ "import" ~ sp ~ "\"" }
list_lookahead         = _{ indent ~ var_name ~ sp ~ ":=" ~ sp ~ "[" }
list_idx_lookahead     = _{ var_name ~ sp ~ "[" }
list_append_lookahead  = _{ indent ~ var_name ~ sp ~ "." ~ sp ~ "append" }
for_lookahead          = _{ indent ~ "for" ~ ws+ ~ identifier_char+ ~ sp ~ ":=" }
od_lookahead           = _{ indent ~ "od" ~ sp ~ ";" }
global_lookahead       = _{ "GLOBAL" ~ sp }
dyn_lookahead = _{ (!")" ~ ANY)* ~ "[" } // Lookahead to ensure parens contain a '[' before matching as dynamic
reduce_lookahead = _{ "reduce!" ~ "(" }

// Raw NuSMV Chunk Catch-All
raw_char = _{ !(list_unpack | import_lookahead | list_lookahead | list_idx_lookahead | list_append_lookahead | for_lookahead | od_lookahead | dyn_constructor | global_lookahead | reduce_lookahead) ~ ANY }
raw_nusmv_chunk = { raw_char+ }

// SMVX Program
program = { SOI ~ (global_block | for_loop | reduce_expr | list | list_indexing | list_unpack | list_append | dyn_constructor | import_stmt | raw_nusmv_chunk)* ~ EOI }