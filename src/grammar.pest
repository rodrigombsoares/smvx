// We cannot use the default WHITESPACE and COMMENT rules, we need to handle comments and explicit spacing
// otherwise nusvm chunks will not be parsed containing trailing \n
ws = _{ " " | "\t" }
newline = _{ "\r\n" | "\n" }
comment = _{ "--" ~ (!newline ~ ANY)* }
sp = _{ (ws | comment)* }
sp_nl = _{ (ws | newline | comment)* }
indent = @{ ws* }

// import
path   = { (ASCII_ALPHANUMERIC | "/" | "." | "_" | "-")+ }
import_stmt = { "import" ~ sp ~ "\"" ~ path ~ "\"" ~ sp ~ ";" }

// Identifiers
identifier_char = _{ ASCII_ALPHANUMERIC | "_" }
list_name       = @{ identifier_char+ }

// List definition
list = { indent ~ list_name ~ sp ~ ":=" ~ sp ~ list_val ~ sp ~ ";" ~ (ws* ~ newline)? }
list_element = { (!("[" | "]" | "," | ";") ~ ANY)+ }

list_val = {
    "[" ~ sp ~ "]" |
    "[" ~ sp ~ list_element ~ (sp ~ "," ~ sp ~ list_element)* ~ sp ~ "]"
}

// List indexing (allows expressions like 'i-1' or '0')
math_op = { "+" | "-" }
index_operand = @{ identifier_char+ | ASCII_DIGIT+ }
index_math = { index_operand ~ sp ~ math_op ~ sp ~ index_operand }
list_idx = { index_math | index_operand }
list_indexing = { list_name ~ sp ~ "[" ~ sp ~ list_idx ~ sp ~ "]" }

// --- LOOKAHEADS ---
// Look for '[' after ':=' so standard NuSMV DEFINE statements (e.g. carry_out := val) are ignored
list_lookahead         = _{ indent ~ list_name ~ sp ~ ":=" ~ sp ~ "[" }
list_idx_lookahead     = _{ list_name ~ sp ~ "[" }
list_append_lookahead  = _{ indent ~ list_name ~ sp ~ "." ~ sp ~ "append" }
for_lookahead          = _{ indent ~ "for" ~ sp ~ identifier_char+ ~ sp ~ ":=" }
od_lookahead           = _{ indent ~ "od" ~ sp ~ ";" }

// Lookahead to ensure parens contain a '[' before matching as dynamic
dyn_lookahead = _{ (!")" ~ ANY)* ~ "[" }

// Dynamic Constructor (Matches only if '[' is present inside parens)
constructor_name = @{ identifier_char+ }
dyn_constructor  = { 
    constructor_name ~ sp ~ 
    &("(" ~ dyn_lookahead) ~ 
    "(" ~ sp ~ arg_expr* ~ sp ~ ")" 
}

// Append and Argument structures
arg_chunk = @{ (!("(" | ")" | ";" | list_idx_lookahead) ~ ANY)+ }
paren_expr = { "(" ~ sp ~ arg_expr* ~ sp ~ ")" }
arg_expr = _{ list_indexing | paren_expr | arg_chunk }

append_element = { dyn_constructor | arg_expr+ }
list_append = { indent ~ list_name ~ sp ~ "." ~ sp ~ "append" ~ sp ~ "(" ~ sp ~ append_element ~ sp ~ ")" ~ sp ~ ";" ~ (ws* ~ newline)* }

// For loops (do ... od;)
loop_var = @{ identifier_char+ }
range_start = { ASCII_DIGIT+ }
range_end = { ASCII_DIGIT+ }

for_body = _{ for_loop | list | list_indexing | list_append | dyn_constructor | raw_nusmv_chunk }
for_loop = { 
    indent ~ "for" ~ sp ~ loop_var ~ sp ~ ":=" ~ sp ~ range_start ~ sp ~ ".." ~ sp ~ range_end ~ sp ~ "do" ~ sp_nl ~ 
    (for_body ~ sp_nl)* ~ 
    "od" ~ sp ~ ";" 
}

// Raw NuSMV Chunk Catch-All
raw_char = _{ !(list_lookahead | list_idx_lookahead | list_append_lookahead | for_lookahead | od_lookahead | dyn_constructor) ~ ANY }
raw_nusmv_chunk = { raw_char+ }

// SMVX Program
program = { SOI ~ (for_loop | list | list_indexing | list_append | dyn_constructor | import_stmt | raw_nusmv_chunk)* ~ EOI }