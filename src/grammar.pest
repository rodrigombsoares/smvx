WHITESPACE = _{ " " | "\t" | "\n" | "\r" }
COMMENT    = _{ "--" ~ (!"\n" ~ ANY)* }

identifier_char = _{ ASCII_ALPHANUMERIC | "_" }
list_name        = @{ identifier_char+ }

// Atomic list rule: whitespace within it is explicitly defined or controlled
list = { list_name ~ ":=" ~ list_val ~ ";" }

list_element = { (!("[" | "]" | "," | ";") ~ ANY)+ }

list_val = {
    "[" ~ "]" |
    "[" ~ list_element ~ ("," ~ list_element)* ~ "]"
}

// Single non-list character
raw_char = _{ !list ~ ANY }

// Silent atomic chunk to avoid polluting AST with hundreds of individual raw_char pairs
raw_nusmv_chunk = { raw_char+ }

program = { SOI ~ (list | raw_nusmv_chunk)* ~ EOI }
